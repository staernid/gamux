# Maintainer: staernid <varpu@firemail.cc>
# WIP!
pkgname=gamux
pkgver=0.3.1
pkgrel=1
pkgdesc="Streamline post-download Steam game management on Linux."
arch=('x86_64' 'aarch64')
url="https://github.com/staernid/gamux"
license=('GPL3')
depends=('p7zip')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::https://github.com/staernid/$pkgname/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
}

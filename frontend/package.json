    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.20.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
